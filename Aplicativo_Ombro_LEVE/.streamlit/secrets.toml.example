# Cole em Settings > Secrets do Streamlit e substitua a chave pelo valor real.
# Nunca envie a chave real ao GitHub.
RESULT_MODE = "email"
RESEND_API_KEY = "SUBSTITUA_PELA_CHAVE_DO_RESEND"
EMAIL_FROM = "Reabilitação do Ombro <onboarding@resend.dev>"
# O remetente resend.dev permite envio apenas ao endereço da própria conta
# Resend. Cadastre a conta com paulolucareli@uni9.pro.br para testar.
# Para uso regular com a turma, configure EMAIL_FROM com um domínio verificado
# e confirme os limites e condições do seu plano no serviço.
